{
  "name": "quick-commerce-mcp",
  "version": "1.6.0",
  "description": "MCP server to search, compare and order from Zepto, Blinkit, Swiggy Instamart and BigBasket via browser automation",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "quick-commerce-mcp": "dist/index.js",
    "quick-commerce-mcp-login": "dist/session-helper.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "AUTHENTICATION.md",
    "MCP_SETUP.md",
    "LICENSE",
    "scripts/bigbasket-windows-bridge.mjs",
    "scripts/bigbasket-windows-worker.mjs",
    "scripts/bigbasket-background-desktop.ps1",
    "scripts/open-bigbasket-browser.mjs",
    "scripts/verify-bigbasket-mcp.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/*.test.js",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm test",
    "check": "npm test && npm run lint && node --check scripts/bigbasket-windows-bridge.mjs && node --check scripts/bigbasket-windows-worker.mjs && node --check scripts/open-bigbasket-browser.mjs && node --check scripts/verify-bigbasket-mcp.mjs && npm audit --audit-level=high",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "mcp",
    "quick-commerce",
    "zepto",
    "blinkit",
    "instamart",
    "bigbasket",
    "automation"
  ],
  "author": "Hardik Khandelwal <hardikkhandelwal500@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.41.0",
    "playwright-stealth": "^0.0.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.39.5",
    "qrcode": "^1.5.4",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hardik500/quick-commerce-mcp.git"
  },
  "homepage": "https://github.com/Hardik500/quick-commerce-mcp#readme",
  "bugs": {
    "url": "https://github.com/Hardik500/quick-commerce-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
